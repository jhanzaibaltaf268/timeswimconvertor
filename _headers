# Applies to every response, including clean URLs (/yards-to-meters) and
# folder indexes (/it/), which an extension pattern like /*.html never matches.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Cache-Control: public, max-age=0, must-revalidate

# Media and icons never change under these names, so cache them hard.
# "! Cache-Control" drops the value set above first — without it Cloudflare
# joins both values with a comma and the result is meaningless.
/*.mp4
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
